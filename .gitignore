# Dependencies (re-created by `npm install`)
node_modules/

# Build output (re-created by `npm run build`)
dist/

# Environment secrets (API keys etc.)
.env
.env.*

# Logs and OS / editor files
*.log
.DS_Store
Thumbs.db
.vscode/

# Private server settings (database + admin passwords)
public/api/config.php
# Photos uploaded on the live site
public/uploads/*
!public/uploads/.htaccess
